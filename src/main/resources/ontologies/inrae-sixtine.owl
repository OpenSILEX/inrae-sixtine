        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#HumiditySensor"/>
        <dc:source>skos:closeMatch Electrical resistance block [GAMP 2.4.1.6.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</dc:source>
        <rdfs:label xml:lang="en">electrical resistance block</rdfs:label>
        <rdfs:label xml:lang="fr">electrical resistance block</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ElectricalResistanceHumiditySensor -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ElectricalResistanceHumiditySensor">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#HumiditySensor"/>
        <dc:source>skos:closeMatch electrical resistance humidity sensor [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf</dc:source>
        <rdfs:comment>certain materials interact with water vapour and undergo a change in electrical resistance, in relation to ambient humidity.</rdfs:comment>
        <rdfs:label xml:lang="en">electrical resistance humidity sensor</rdfs:label>
        <rdfs:label xml:lang="fr">electrical resistance humidity sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ElectricalResistanceThermometer -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ElectricalResistanceThermometer">
