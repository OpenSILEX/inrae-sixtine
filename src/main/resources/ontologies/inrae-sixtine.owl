        <rdfs:comment xml:lang="fr">Plante vivace ligneuse à une seule tige principale, ou dans le cas des taillis à plusieurs tiges, à couronne plus ou moins définie.</rdfs:comment>
        <rdfs:label xml:lang="fr">Arbre</rdfs:label>
        <rdfs:label xml:lang="en">Tree</rdfs:label>
    </owl:Class>
    


