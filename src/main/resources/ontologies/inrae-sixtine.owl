    <!-- http://www.opensilex.org/vocabulary/oeso#Species -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Species"/>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#SubPlot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#SubPlot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#PlotComponent"/>
        <rdfs:comment xml:lang="fr">Principal composant de &quot;Parcelle Unitaire&quot; en général considéré comme un individu statistique permettant de rendre compte de la variabilité au sein de la &quot;Parcelle Unitaire&quot;. L&apos;ensemble de ces composants sera souvent considéré comme représentatif de la &quot;Parcelle Unitaire&quot; qu&apos;ils composent, sauf si l&apos;un d&apos;eux a subi un effet qui le disqualifie (dégats, adventice, etc...).</rdfs:comment>
        <rdfs:label xml:lang="fr">Sous-Parcelle Unitaire</rdfs:label>
        <rdfs:label xml:lang="en">SubPlot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#TIRCamera -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#TIRCamera">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Camera"/>
        <rdfs:label xml:lang="en">IR thermal camera</rdfs:label>
        <rdfs:label xml:lang="fr">caméra infrarouge thermique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Transect -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Transect">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="fr">Groupe de &quot;Composants Parcellaires&quot; (en général des &quot;Placettes&quot;) pouvant être répartis sur plusieurs &quot;Parcelles Unitaires&quot; selon des règles prédéfinies (généralement perpendiculaire à la bordure latérale d&apos;une Parcelle Unitaire) et sur lesquels des mêmes mesures sont réalisées afin d&apos;estimer des variations le long d&apos;un axe.</rdfs:comment>
        <rdfs:label xml:lang="en">Transect</rdfs:label>
        <rdfs:label xml:lang="fr">Transect</rdfs:label>
    </owl:Class>
    


