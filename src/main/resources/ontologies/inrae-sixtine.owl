        <dc:source>skos:closeMatch Resistance thermometer [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html</dc:source>
        <rdfs:comment>For small temperature changes, the increase in resistance of pure metals is proportional to the change in temperature. Often made in Platinum.</rdfs:comment>
        <rdfs:label xml:lang="en">electrical resistance thermometer</rdfs:label>
        <rdfs:label xml:lang="fr">electrical resistance thermometer</rdfs:label>
    </owl:Class>
    


