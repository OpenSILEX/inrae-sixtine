        <rdfs:domain rdf:resource="http://www.opensilex.org/vocabulary/oeso#Germplasm"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeso#Species"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#fromVariety -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#fromVariety">
