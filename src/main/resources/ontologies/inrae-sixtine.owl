    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#hasFinancialFunding -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#hasFinancialFunding">
        <rdfs:domain rdf:resource="http://www.opensilex.org/vocabulary/oeso#Project"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeso#FinancialFunding"/>
        <rdfs:label xml:lang="fr">financement</rdfs:label>
        <rdfs:label xml:lang="en">financial funding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#hasGermplasm -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#hasGermplasm">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeso#Germplasm"/>
        <rdfs:label xml:lang="en">Germplasm</rdfs:label>
        <rdfs:label xml:lang="fr">Matériel génétique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#hasSpecies -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#hasSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeso#Species"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#hasTechnicalContact -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#hasTechnicalContact">
        <rdfs:subPropertyOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasContact"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#Device"/>
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#Experiment"/>
                    <rdf:Description rdf:about="http://www.opensilex.org/vocabulary/oeso#Project"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="fr">contact technique</rdfs:label>
        <rdfs:label xml:lang="en">technical contact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#hasTrait -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#hasTrait">
        <rdfs:label xml:lang="en">trait</rdfs:label>
        <rdfs:label xml:lang="fr">trait</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#measuredVariable -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#measuredVariable">
        <rdfs:label xml:lang="en">measured variable</rdfs:label>
        <rdfs:label xml:lang="fr">variable mesurée</rdfs:label>
    </owl:ObjectProperty>
    


