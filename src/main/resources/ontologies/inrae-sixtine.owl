    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ResearchInfrastructure">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="fr">Infrastructure de Recherche</rdfs:label>
        <rdfs:label xml:lang="en">Research Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ResearchInstitut -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ResearchInstitut">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:label xml:lang="fr">Institut de Recherche</rdfs:label>
        <rdfs:label xml:lang="en">Research Institut</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#RootSystem -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#RootSystem">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="fr">Organe végétal (généralement souterrain) à fonction d&apos;absorption d&apos;eau et de nutriments, d&apos;ancrage dans le milieu suport de la plante, parfois de stockage d&apos;énergie ou de reproduction végétative.</rdfs:comment>
        <rdfs:label xml:lang="en">Root System</rdfs:label>
        <rdfs:label xml:lang="fr">Système Racinaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Rootstock -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Rootstock">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="en">Grape variety used as the underground portion of a grafted vine onto which the scion is grafted. Bred to provide pest resistance and/or adaptability to unfavorable soil or environmental conditions.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Partie (en général souterraine) d&apos;une plante sur laquelle est greffée un &quot;Greffon&quot;; en général choisie pour les qualités de son système racinaire, sa résistance aux maladies et/ou son adaptabilité à des conditions environnementales ou des sols défavorables.</rdfs:comment>
        <rdfs:label xml:lang="fr">Porte-greffe</rdfs:label>
        <rdfs:label xml:lang="en">Rootstock</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Row -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Row">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="fr">Composant de &quot;Parcelle Unitaire&quot; correspondant à un alignement de plantes.</rdfs:comment>
        <rdfs:label xml:lang="fr">Rang</rdfs:label>
        <rdfs:label xml:lang="en">Row</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ScientificObject -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ScientificObject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasGermplasm"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.opensilex.org/vocabulary/oeso#Germplasm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasReplication"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Entité physique qui est la principale unité d&apos;intérêt, sur laquelle sont réalisées des observations, mesures ou prélèvements.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#ScientificObjectArea -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#ScientificObjectArea">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="fr">Surface délimitée particulière</rdfs:comment>
        <rdfs:label xml:lang="en">Area</rdfs:label>
        <rdfs:label xml:lang="fr">Zone</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#Scion -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#Scion">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#ScientificObject"/>
        <rdfs:comment xml:lang="en">Is the part of the vine, usually Vitis vinifera, that is grafted on the rootstock and from which wine grapes will be harvested from</rdfs:comment>
        <rdfs:comment xml:lang="fr">Partie (en général aérienne) d&apos;une plante qui est gréffée sur un &quot;Porte-Greffe&quot;; en général choisie pour les qualités de ses tiges, feuilles, fleurs ou fruits.</rdfs:comment>
        <rdfs:label xml:lang="fr">Greffon</rdfs:label>
        <rdfs:label xml:lang="en">Scion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#SeedLot -->

    <owl:Class rdf:about="http://www.opensilex.org/vocabulary/oeso#SeedLot">
        <rdfs:subClassOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#Germplasm"/>
        <rdfs:label xml:lang="fr">Lot de semence</rdfs:label>
        <rdfs:label xml:lang="en">Seed Lot</rdfs:label>
    </owl:Class>
    


