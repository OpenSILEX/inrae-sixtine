    <!-- http://www.opensilex.org/vocabulary/oeev#hasPest -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeev#hasPest">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.opensilex.org/vocabulary/oeev#PestAttack"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeev#Pest"/>
        <rdfs:label xml:lang="en">has pest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#concerns -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#concerns">
        <rdfs:label xml:lang="fr">concerne</rdfs:label>
        <rdfs:label xml:lang="en">concerns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#endDate -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#endDate">
        <rdfs:subPropertyOf rdf:resource="http://www.opensilex.org/vocabulary/oeso#hasDate"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#fromAccession -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#fromAccession">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.opensilex.org/vocabulary/oeso#Germplasm"/>
        <rdfs:range rdf:resource="http://www.opensilex.org/vocabulary/oeso#Accession"/>
    </owl:ObjectProperty>
    


    <!-- http://www.opensilex.org/vocabulary/oeso#fromSpecies -->

    <owl:ObjectProperty rdf:about="http://www.opensilex.org/vocabulary/oeso#fromSpecies">
