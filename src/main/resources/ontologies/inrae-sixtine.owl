     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:time="http://www.w3.org/2006/time#">
    <owl:Ontology rdf:about="http://www.opensilex.org/vocabulary/oeso-sixtine">
        <dc:creator>Anne Tireau, Llorenç Cabrera-Bosquet, Pascal Neveu (INRA Montpellier)</dc:creator>
        <rdfs:comment>INRA MISTEA
            Copyright © - INRAE - 2014 - 2026
            Oeso extention ontology for Sixtine is licensed by CC 4.0 (http://creativecommons.org/licenses/by-sa/4.0/legalcode)</rdfs:comment>
        <rdfs:label xml:lang="en">OpenSILEX - Sixtine</rdfs:label>
        <owl:versionInfo>Version 1.1 (2021-11-15) created by INRAE
for 1.4.0 of opensilex core</owl:versionInfo>
    </owl:Ontology>
    


